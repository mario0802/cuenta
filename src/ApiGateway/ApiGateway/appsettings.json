{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "cliente-route": {
        "ClusterId": "cliente-cluster",
        "Match": {
          "Path": "/api/cliente-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "cuenta-route": {
        "ClusterId": "cuenta-cluster",
        "Match": {
          "Path": "/api/cuenta-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "cliente-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://client.api:8080" }
        }
      },
      "cuenta-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://account.api:8080" }
        }
      }
    }
  }
}